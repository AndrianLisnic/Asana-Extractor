# Personal access token (PAT) or OAuth access token with the projects:read scope.
# The value is sent to Asana as: Authorization: Bearer <token>
EXTRACTOR_TOKEN=replace_with_your_asana_token

# Workspace GID used to scope GET /projects and enable cursor pagination.
ASANA_WORKSPACE_GID=replace_with_your_workspace_gid

# Optional. Keep the default for the public Asana API.
EXTRACTOR_BASE_URL=https://app.asana.com

# Optional polling interval. Go duration syntax: 30s, 1m, 5m, etc.
PULL_INTERVAL=30s

# Optional Asana pagination size. The API accepts values from 1 to 100.
PER_PAGE=50

# Optional output file path.
PROJECTS_OUTPUT_PATH=data/projects/
USERS_OUTPUT_PATH=data/users/
